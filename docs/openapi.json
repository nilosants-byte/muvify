{
  "openapi": "3.0.0",
  "info": {
    "title": "Personal Services Marketplace API",
    "version": "1.1.0",
    "description": "API para marketplace de servicos pessoais."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Cadastro de usuario",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Renova o access token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoga o refresh token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Solicita token de recuperacao de senha",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Redefine a senha a partir de token de recuperacao",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/verify-email": {
      "get": {
        "summary": "Verifica o e-mail do usuario a partir do link enviado por e-mail",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/resend-verification": {
      "post": {
        "summary": "Reenvia o e-mail de verificacao para o usuario autenticado",
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "tags": []
}