# =============================================================
# CHECKLIST PRODUÇÃO — marque antes de fazer deploy:
# [ ] JWT_SECRET: >= 32 chars aleatórios (openssl rand -base64 32)
# [ ] APP_ENCRYPTION_KEY: >= 32 chars, diferente do JWT_SECRET
# [ ] REDIS_URL: rediss:// (TLS) obrigatório
# [ ] CORS_ORIGIN: apenas https://, domínios explícitos
# [ ] MP_WEBHOOK_SECRET: preenchido (Mercado Pago dashboard)
# [ ] METRICS_TOKEN: definido
# [ ] SMTP_*: todos configurados
# [ ] NODE_ENV=production
# [ ] E2E_BYPASS_ONBOARDING_GATES: ausente ou false (nunca true em produção)
# =============================================================
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
POSTGRES_DB=marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace_test?schema=public
# Banco descartavel dedicado para "prisma migrate dev/diff" - NUNCA aponte
# isso (nem passe --shadow-database-url manualmente) pro mesmo banco de
# DATABASE_URL, ou o Prisma vai resetar seus dados reais.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace_shadow?schema=public
# Development: redis://  |  Produção: OBRIGATÓRIO rediss:// (TLS)
REDIS_URL=redis://localhost:6379
AUTH_REQUIRE_REDIS_FOR_BLACKLIST=
# Kill switches operáveis sem deploy (troque e reinicie o processo) — ver docs/INCIDENT-RUNBOOK.md
ENABLE_VIDEO_UPLOAD=true
ENABLE_REALTIME_CHAT=true
# [OBRIGATÓRIO] Mínimo 32 chars. Em produção: openssl rand -base64 32
JWT_SECRET=mude-esta-chave-em-producao-minimo-32-caracteres
# [OBRIGATÓRIO em produção] Mínimo 32 chars, diferente do JWT_SECRET. openssl rand -hex 32
APP_ENCRYPTION_KEY=mude-esta-chave-criptografia-em-producao-32c
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
PASSWORD_RESET_WEB_URL=http://localhost:8081/reset-password
PASSWORD_RESET_TOKEN_EXPOSE_IN_DEV=true
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=72
EMAIL_VERIFICATION_WEB_URL=http://localhost:3000/auth/verify-email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@minhaempresa.com
SMTP_PASS=senha
SMTP_FROM=no-reply@minhaempresa.com
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_ENABLED_IN_TEST=false
SMTP_VERIFY_ON_STARTUP=
SUPPORT_EMAIL_RECIPIENT=suporte@minhaempresa.com
# Nome exibido como remetente nos emails de suporte
SUPPORT_EMAIL_FROM_NAME=Suporte Muvify
ADMIN_ALLOWED_EMAILS=
# [OPCIONAL] Senha para proteger /api/docs (Swagger) em produção
SWAGGER_BASIC_AUTH_PASSWORD=
# Produção: APENAS https://, múltiplos separados por vírgula, proibido "*"
CORS_ORIGIN=http://localhost:3000
# [OBRIGATÓRIO em produção] Token para acesso às métricas
METRICS_TOKEN=
TRUST_PROXY=1
API_JSON_LIMIT=10mb
BACKUP_ENCRYPTION_KEY=BASE64_32_BYTES
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_OFFSITE_PROVIDER=none
BACKUP_S3_BUCKET=meu-bucket
BACKUP_S3_PREFIX=backups
AWS_REGION=us-east-1
BACKUP_VERIFY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace_verify?schema=public
BACKUP_SCHEDULE_INTERVAL_MINUTES=1440
BACKUP_SCHEDULE_JITTER_SECONDS=60
BACKUP_SCHEDULE_LOCK_TIMEOUT_MINUTES=60
BACKUP_ON_START=true
DB_BACKUP_BEFORE_RESTORE=true
DB_BACKUP_MODE=docker
DB_BACKUP_CONTAINER=marketplace_postgres
PG_DUMP_BIN=pg_dump
PSQL_BIN=psql
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_SLACK_CHANNEL=#alertas
ALERT_SLACK_USERNAME=alertmanager
ALERT_EMAIL_TO=alerts@minhaempresa.com
ALERT_EMAIL_FROM=no-reply@minhaempresa.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=user@minhaempresa.com
ALERT_SMTP_PASS=senha
ALERT_SMTP_TLS=true
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
# [OBRIGATÓRIO em produção] Token para validar webhooks do Mercado Pago
MP_WEBHOOK_SECRET=
MP_APP_ID=
MP_CLIENT_SECRET=
MP_CONNECT_RETURN_URL=http://localhost:3000/mp/return
MP_CONNECT_REFRESH_URL=http://localhost:3000/mp/refresh
PRE_AUTH_WINDOW_MINUTES=60
BOOKING_ATTENDANCE_CODE_RELEASE_MINUTES=10
BOOKING_ATTENDANCE_CODE_EXPIRY_HOURS=6
REQUIRE_ANAMNESIS_FOR_CONTRACTS=false
# Interruptor central pro checklist de teste manual ponta a ponta: libera de
# uma vez CREF, e-mail verificado, anamnese, reconsentimento de termos e
# assinatura do profissional. NUNCA deixar true em produção — o app se
# recusa a subir se NODE_ENV=production e essa flag vier true.
E2E_BYPASS_ONBOARDING_GATES=false
AUTO_CAPTURE_CONFIRMATION_HOURS=24
CONSULTANCY_DELIVERY_DEADLINE_HOURS=48
PAYMENT_JOB_INTERVAL_SECONDS=60
RUN_PAYMENT_JOBS=true
RUN_REMINDER_JOBS=true
REMINDER_JOB_INTERVAL_SECONDS=60
RUN_EMAIL_RETRY_JOB=true
EMAIL_RETRY_JOB_INTERVAL_SECONDS=30
RUN_DATA_RETENTION_JOBS=true
DATA_RETENTION_JOB_INTERVAL_MINUTES=1440
DATA_RETENTION_DRY_RUN=false
ALLOW_DATA_RETENTION_DRY_RUN_IN_PRODUCTION=false
DATA_RETENTION_LEGAL_HOLD_USER_IDS=
PUSH_NOTIFICATIONS_ENABLED=true
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Script de seed do admin (apenas para setup inicial, nunca expor valores reais)
SEED_ADMIN_EMAIL=admin@seudominio.com.br
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Muvify Admin
