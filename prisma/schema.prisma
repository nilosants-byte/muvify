  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId, createdAt])
}

model FeedPostComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

// Épico de Frentes, Frente 8, Lote 2: o botão "Denunciar" do app não
// persistia nada - o post denunciado passa a sumir da visão de quem
// denunciou (assertPostVisibleToViewer/getFeed em feed.service.ts). A fila
// de revisão do admin fica para a Frente 10 (Operação administrativa).
model FeedPostReport {
  id         String   @id @default(uuid())
  postId     String
  reporterId String
  reason     String?
  status       ContentReportStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  createdAt  DateTime @default(now())
  post       FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("FeedPostReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([postId, reporterId])
  @@index([postId])
  @@index([status, createdAt])
}

model RankingSnapshot {
  id                String            @id @default(uuid())
  userId            String
  periodType        RankingPeriodType
  periodKey         String
  xpEarned          Int               @default(0)
  lastKnownPosition Int?
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodType, periodKey])
  @@index([periodType, periodKey, xpEarned])
  @@index([periodType, periodKey, xpEarned, userId])
}
