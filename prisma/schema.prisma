generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  // Banco descartavel dedicado — "migrate dev"/"migrate diff" sempre usam
  // este banco como rascunho (reset a cada rodada), nunca o banco real.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum CrefValidationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING_AUTH
  AUTHORIZING
  AUTHORIZED
  CAPTURED
  CANCELED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  CREDIT_CARD
  DEBIT_CARD
  PIX
}

enum ServiceOfferKind {
  PRESENTIAL
  ONLINE_CONSULTANCY
  ONLINE_CONSULTANCY_SPECIALIZED
  COMBO
}

enum OfferBillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum ConsultancyRequestStatus {
  OPEN
  RESPONDED
  ACCEPTED
  REFUSED
  EXPIRED
  EXPIRED_REFUNDED
  ARCHIVED
}

enum ConsultancyContractStatus {
  PENDING_PAYMENT
  ACTIVE
  DELIVERED
  CANCELLED
  REFUNDED_EXPIRED
  ARCHIVED
}

enum ConsultancyPaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  CANCELED
  REFUNDED
  FAILED
}

enum ConsultancyPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
}

enum CameraFacing {
  FRONT
  BACK
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum BankAccountType {
  CHECKING
  SAVINGS
}

enum AnamnesisStatus {
  DRAFT
  COMPLETED
}

enum ProviderServiceMode {
  PRESENTIAL_ONLY
  HOME_VISIT_ONLY
  BOTH
}

enum FinancialStudentType {
  PRESENTIAL
  ONLINE
  APP
  BOTH
}

enum FinancialExpenseCategory {
  GYM
  TRANSPORT
  EQUIPMENT
  MARKETING
  FORMATION
  SOFTWARE
  PROFESSIONAL_SERVICES
  RENT
  UNIFORM
  NUTRITION
  OTHER
}

enum FinancialRecurrence {
  RECURRING
  ONE_TIME
}

enum NotificationPreferenceType {
  BOOKINGS
  PAYMENTS
  MARKETING
  CONSULTANCY
  SYSTEM
  // Épico de Frentes, Frente 8, Lote 12: novo seguidor, marco de streak,
  // conquista desbloqueada e menção em post - antes desse valor existir,
  // o push de "novo seguidor" não passava nenhum preferenceType, e sem
  // categoria o filtro de preferência é pulado por completo (usuário não
  // conseguia desativar).
  COMMUNITY
  // Épico de Frentes, Frente 9, Lote 19: mensagem nova de chat (agendamento
  // e consultoria) reaproveitava BOOKINGS/CONSULTANCY sem necessidade -
  // desativar avisos de sessão/consultoria também silenciava chat, e
  // vice-versa. Categoria própria.
  CHAT
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
}

// Épico de Frentes, Frente 10, Lote 1: as 3 filas de denúncia (post, chat de
// agendamento, chat de consultoria) só persistiam o registro, sem status
// nenhum de revisão - nada indicava se um admin já olhou, descartou ou agiu
// sobre a denúncia.
enum ContentReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}

enum XpReason {
  PRESENTIAL_WORKOUT_COMPLETED
  ONLINE_WORKOUT_COMPLETED
  TRAINING_PLAN_COMPLETED
  POST_WORKOUT_PHOTO
  REVIEW_SUBMITTED
  NEW_PROVIDER_FIRST_SESSION
  SERVICE_PURCHASED
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
  WEEKLY_RANKING_1ST
  WEEKLY_RANKING_2ND
  WEEKLY_RANKING_3RD
  MONTHLY_RANKING_1ST
  MONTHLY_RANKING_2ND
  MONTHLY_RANKING_3RD
  GENERAL_RANKING_1ST_REACHED
  GENERAL_RANKING_2ND_REACHED
  GENERAL_RANKING_3RD_REACHED
  FIRST_BOOKING
  FIRST_CONSULTANCY
  EVERY_10_BOOKINGS
  STREAK_MILESTONE_15
  STREAK_MILESTONE_30
  STREAK_MILESTONE_45
  STREAK_MILESTONE_90
}

enum AchievementCategory {
  CONSISTENCY
  VOLUME
  SOCIAL
  RANKING
  PROGRESSION
}

enum MedalType {
  SPECIAL
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum AchievementConditionType {
  STREAK_SESSIONS
  TOTAL_WORKOUTS
  TOTAL_FOLLOWING
  TOTAL_FOLLOWERS
  WEEKLY_TOP3_REACHED
  WEEKLY_1ST_REACHED
  WEEKLY_TOP3_CONSECUTIVE_WEEKS
  TOTAL_REVIEWS_SUBMITTED
  TOTAL_PHOTO_POSTS
  DISTINCT_PROVIDERS_TRAINED
  LEVEL_REACHED
}

enum FeedPostType {
  WORKOUT_COMPLETED
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
  STREAK_MILESTONE
  RANKING_POSITION_CLIMBED
  RANKING_ENTERED_WEEKLY_TOP3
  RANKING_WEEK_ENDED_TOP3
  RANKING_MONTH_ENDED_TOP3
  RANKING_ENTERED_MONTHLY_TOP5
  RANKING_ENTERED_GENERAL_TOP5
  // Épico de Frentes, Frente 8, Lote 16: o nome sugere que sempre tem foto,
  // mas createPhotoPostSchema aceita imageUrl OU caption - pode ser um post
  // só-texto (só não concede mais XP de "foto de treino" nesse caso, ver
  // Lote 1). O nome ficou por compatibilidade com posts já existentes.
  MANUAL_PHOTO
}

enum RankingPeriodType {
  WEEKLY
  MONTHLY
  ALLTIME
}

model User {
  id                       String                      @id @default(uuid())
  name                     String
  apelido                  String?                     @unique
  email                    String                      @unique
  password                 String
  phone                    String?
  photoUrl                 String?
  recoveryEmailEncrypted   String?
  role                     UserRole                    @default(CLIENT)
  emailVerifiedAt          DateTime?
  mpCustomerId             String?
  mpDefaultCardId          String?
  termsAcceptedAt          DateTime?
  privacyPolicyAcceptedAt  DateTime?
  termsVersion             String?
  twoFactorSecret          String?
  twoFactorEnabled         Boolean                     @default(false)
  twoFactorEnabledAt       DateTime?
  document                 String?
  documentHash             String?
  trainingDaysPerWeek      Int                         @default(3)
  noShowStrikes            Int                         @default(0)
  suspendedAt              DateTime?
  suspensionReason         String?
  // Raio-X de pagamentos, Rodada 4, Lote 9: legal hold (retenção de dados por
  // obrigação legal, ex: processo judicial em curso) era só variável de
  // ambiente fixa — mudar exigia editar env var e redeployar. Agora
  // persistido por usuário; o job automático de retenção passa a consultar
  // isso além da env var (que continua valendo como fallback/lista extra).
  legalHoldUntil           DateTime?
  legalHoldReason          String?
  customerPaymentMethods   CustomerPaymentMethod[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  providerProfile          ProviderProfile?
  bookings                 Booking[]                   @relation("ClientBookings")
  reviews                  Review[]
  favorites                Favorite[]
  completionEvidences      CompletionEvidence[]
  consultancyRequestsSent  ConsultancyRequest[]        @relation("ClientConsultancyRequests")
  consultancyContracts     ConsultancyContract[]       @relation("ClientConsultancyContracts")
  sessions                 Session[]
  pushDevices              PushDevice[]
  notifications            UserNotification[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  consentRecords           ConsentRecord[]
  twoFactorLoginChallenges TwoFactorLoginChallenge[]
  twoFactorBackupCodes     TwoFactorBackupCode[]
  anamnesisProfile         ClientAnamnesis?
  physicalAssessments      ProviderStudentAssessment[] @relation("AssessmentClient")
  trainingPlanCompletions  TrainingPlanCompletion[]
  presentialPackages       PresentialPackage[]         @relation("ClientPresentialPackages")
  chatMessages             BookingMessage[]
  consultancyMessages      ConsultancyMessage[]
  bookingMessageReports    BookingMessageReport[]
  consultancyMessageReports ConsultancyMessageReport[]
  notificationPreferences  NotificationPreference[]
  supportTicketsSubmitted  SupportTicket[]             @relation("SupportTicketRequester")
  supportTicketsResponded  SupportTicket[]             @relation("SupportTicketResponder")
  xpTransactions           UserXpTransaction[]
  streak                   UserStreak?
  unlockedAchievements     UserAchievement[]
  following                Follow[]                    @relation("Follower")
  followers                Follow[]                    @relation("Following")
  feedPosts                FeedPost[]
  feedPostLikes            FeedPostLike[]
  feedPostComments         FeedPostComment[]
  feedPostReports          FeedPostReport[]
  feedPostReportsReviewed   FeedPostReport[]           @relation("FeedPostReportReviewer")
  bookingMessageReportsReviewed BookingMessageReport[]  @relation("BookingMessageReportReviewer")
  consultancyMessageReportsReviewed ConsultancyMessageReport[] @relation("ConsultancyMessageReportReviewer")
  feedPostsHiddenByAdmin    FeedPost[]                  @relation("FeedPostHiddenByAdmin")
  bookingMessagesHiddenByAdmin BookingMessage[]          @relation("BookingMessageHiddenByAdmin")
  consultancyMessagesHiddenByAdmin ConsultancyMessage[]  @relation("ConsultancyMessageHiddenByAdmin")
  rankingSnapshots         RankingSnapshot[]
  adminAuditLogs           AdminAuditLog[]
  noShowReportsReceived    NoShowReport[]              @relation("NoShowReported")
  noShowReportsFiled       NoShowReport[]              @relation("NoShowReportedBy")
  disputeCasesAsClient     DisputeCase[]               @relation("DisputeCaseClient")
  disputeCasesResolved     DisputeCase[]               @relation("DisputeCaseResolvedBy")
  debtRecords              DebtRecord[]
  crefDocumentUploads      CrefDocumentUpload[]

  @@index([createdAt])
  @@index([documentHash])
}

// Frente 2 (Segurança do código), Lote 4: registra quem fez upload de cada
// chave de documento de CREF no momento do upload, pra upsertOwnCredentials
// poder validar que a chave enviada no body foi realmente enviada por esse
// mesmo usuário, em vez de confiar cegamente no que o client declarar.
model CrefDocumentUpload {
  id             String   @id @default(uuid())
  storageKey     String   @unique
  uploadedByUser String
  createdAt      DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedByUser], references: [id], onDelete: Cascade)

  @@index([uploadedByUser])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  // Épico de Frentes, Frente 10, Lote 5: novo GET /admin/audit-logs?targetId=
  // consulta por alvo (ex: histórico de moderação de um usuário) - sem
  // índice, cresce em table scan à medida que a trilha de auditoria acumula.
  @@index([targetId])
}

model ProviderProfile {
  id                          String                      @id @default(uuid())
  userId                      String                      @unique
  displayName                 String
  bio                         String
  experienceYears             Int
  priceCents                  Int
  serviceRadiusKm             Int?
  latitude                    Float?
  longitude                   Float?
  serviceMode                 ProviderServiceMode         @default(BOTH)
  minBookingNoticeHours       Int                         @default(24)
  // Frente 5 (Descoberta, agendamento e agenda), Lote 3: não existia
  // conceito de duração de sessão — a checagem de conflito de horário
  // comparava só igualdade exata de instante, permitindo dois agendamentos
  // que na prática se sobrepõem (ex: 10:00 e 10:05) coexistirem sem erro.
  sessionDurationMinutes       Int                         @default(60)
  fixedLocations              Json?
  excludedLocations           Json?
  averageRating               Float                       @default(0)
  totalReviews                Int                         @default(0)
  photoUrl                    String?
  presentationVideoUrl        String?
  mpAccountId                 String?
  mpAccessToken               String?
  mpRefreshToken              String?
  mpTokenExpiresAt            DateTime?
  // Raio-X de pagamentos, Lote 5: setado quando a renovacao do token com o
  // Mercado Pago falha de um jeito que nao se resolve sozinho tentando de
  // novo (ex: profissional revogou o acesso do app no proprio painel do
  // MP) - antes disso ficava so num log interno, sem ninguem saber que as
  // vendas desse profissional pararam de repassar. Limpo automaticamente
  // quando ele reconecta a conta com sucesso.
  mpTokenInvalidatedAt        DateTime?
  crefNumber                  String?
  crefDocumentUrl             String?
  credentialDocuments         Json?
  crefValidatedAt             DateTime?
  // Frente 3 (Cadastro/onboarding), Lote 2: setado só quando o CREF muda de
  // verdade (upsertOwnCredentials), não em qualquer update de perfil - a
  // fila do admin usa este campo pra ordenar por ordem de submissão real,
  // já que updatedAt é tocado por qualquer edição de bio/preço/etc.
  crefSubmittedAt             DateTime?
  crefValidationStatus        CrefValidationStatus        @default(PENDING)
  crefRejectionReason         String?                     @db.VarChar(300)
  // Raio-X de pagamentos, Rodada 4, Lote 12: crefRejectionReason é
  // sobrescrito a cada revisão (fica null de novo se a próxima tentativa for
  // aprovada) — sem isso, não existia nenhum jeito de saber que um
  // profissional já foi reprovado 3 vezes antes de finalmente aprovar.
  crefRejectionCount           Int                         @default(0)
  crefReviewedAt              DateTime?
  crefReviewedByUserId        String?
  specialties                 Json?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryLinks               ProviderCategory[]
  availabilities              Availability[]
  bookings                    Booking[]                   @relation("ProviderBookings")
  reviews                     Review[]
  favoritedBy                 Favorite[]
  serviceOffers               ProviderServiceOffer[]
  onlineConsultancySetting    OnlineConsultancySetting?
  trainingPlans               TrainingPlan[]
  exercises                   Exercise[]
  consultancyRequestsReceived ConsultancyRequest[]        @relation("ProviderConsultancyRequests")
  consultancyContracts        ConsultancyContract[]       @relation("ProviderConsultancyContracts")
  presentialPackages          PresentialPackage[]
  disputeCases                DisputeCase[]               @relation("DisputeCaseProvider")
  bankAccount                 ProviderBankAccount?
  calendarEvents              ProviderCalendarEvent[]
  studentAssessments          ProviderStudentAssessment[]
  trainingPlanCompletions     TrainingPlanCompletion[]
  financialStudents           FinancialStudent[]
  financialIncomes            FinancialIncome[]
  financialExpenses           FinancialExpense[]
  financialGoals              FinancialGoal[]
  manualBlocks                ProviderManualBlock[]
  debtRecords                 DebtRecord[]

  @@index([displayName])
  @@index([serviceMode, averageRating])
  @@index([latitude, longitude])
  @@index([crefValidatedAt, averageRating, totalReviews])
}

model ServiceCategory {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  // Frente 3 (Cadastro/onboarding), Lote 4: soft-delete - nunca exclusão
  // física, pra não quebrar referências de bookings/pacotes/perfis
  // existentes (onDelete: Cascade/Restrict continuam intactos). Categoria
  // desativada some da listagem pública, mas segue íntegra pra quem já a
  // referencia.
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  providers          ProviderCategory[]
  bookings           Booking[]
  presentialPackages PresentialPackage[]
}

model ProviderCategory {
  providerId String
  categoryId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
}

model Availability {
  id         String          @id @default(uuid())
  providerId String
  weekday    Int
  startTime  String
  endTime    String
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, weekday])
}

model Booking {
  id                        String               @id @default(uuid())
  clientId                  String
  providerId                String
  categoryId                String
  packageId                 String?
  // Épico de Frentes, Frente 6 (Ofertas do profissional), Lote 3: sem
  // persistir qual oferta gerou o booking, não havia como reaplicar a
  // restrição de método de pagamento da oferta (acceptsPix/
  // acceptsDebitCard/acceptsCreditCard) na troca de método pré-captura
  // (selectBookingPaymentMethod) — só no momento da criação.
  offerId                   String?
  scheduledAt               DateTime
  priceCents                Int
  currency                  String               @default("BRL")
  notes                     String?
  sessionLocation           String?
  status                    BookingStatus        @default(PENDING)
  attendanceCode            String?
  attendanceCodeGeneratedAt DateTime?
  attendanceCodeExpiresAt   DateTime?
  attendanceCodeValidatedAt DateTime?
  clientConfirmedAt         DateTime?
  providerConfirmedAt       DateTime?
  completedAt               DateTime?
  reminder60SentAt          DateTime?
  reminder30SentAt          DateTime?
  immediateExecutionAcknowledgedAt DateTime?
  // Raio-X de pagamentos, Rodada 4, Lote 4: diferente de consultoria (que já
  // tinha responseDeadlineAt desde a Rodada 1), agendamento avulso não tinha
  // nenhum prazo pro profissional confirmar — só expirava depois que o
  // horário da sessão já tinha passado.
  confirmationDeadlineAt      DateTime?
  confirmationReminderSentAt  DateTime?
  // Épico de Frentes, Frente 9, Lote 15: lembrete de avaliação pendente -
  // cliente só avaliava se lembrasse sozinho, sem nenhum aviso proativo.
  reviewReminderSentAt        DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  client                    User                 @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  provider                  ProviderProfile      @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)
  category                  ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  package                   PresentialPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  offer                     ProviderServiceOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  review                    Review?
  payment                   Payment?
  completionEvidences       CompletionEvidence[]
  chatMessages              BookingMessage[]
  noShowReport              NoShowReport?
  disputeCases              DisputeCase[]

  @@index([providerId, scheduledAt])
  @@index([clientId, scheduledAt])
  @@index([providerId, status])
  @@index([clientId, status])
  @@index([status, scheduledAt])
  @@index([packageId])
}

enum NoShowReportStatus {
  PENDING
  CONTESTED
  RESOLVED
}

model NoShowReport {
  id                String             @id @default(uuid())
  bookingId         String             @unique
  reportedUserId    String
  reportedByUserId  String
  status            NoShowReportStatus @default(PENDING)
  reportReason      String?
  contestReason     String?
  contestDeadlineAt DateTime           @default(now())
  contestedAt       DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())
  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reportedUser      User               @relation("NoShowReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedByUser    User               @relation("NoShowReportedBy", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  disputeCase       DisputeCase?

  @@index([reportedUserId])
  @@index([status, contestDeadlineAt])
}

enum DisputeCaseType {
  NO_SHOW_CONTESTED
  CHARGEBACK
  REFUND_FAILED
  DELIVERY_CONTESTED
  AUTO_CAPTURE_CONTESTED
  CAPTURE_FAILED
  // Frente 4 (Criação/entrega/evolução do treino), Lote 2: rede de
  // segurança pra sessões que ficaram travadas em CONFIRMED com os dois
  // lados já confirmados (bug de corrida corrigido, mas dados antigos
  // podem ter ficado presos assim) - sessão claramente aconteceu
  // (attendanceCodeValidatedAt setado), não é um caso de estorno automático.
  CONFIRMATION_DEADLOCK
}

enum DisputeCaseStatus {
  OPEN
  RESOLVED
}

enum DisputeCaseResolution {
  REFUNDED
  DENIED
  CAPTURED
}

// Fila unica de casos que precisam de julgamento humano (nao dava pra
// automatizar "quem tem razao") - alimentada por 3 fontes: falta
// contestada, contestacao de pagamento pelo banco (chargeback), e
// reembolso automatico que falhou. O admin resolve com um motivo
// obrigatorio, que viaja junto na notificacao pras partes.
model DisputeCase {
  id                       String                 @id @default(uuid())
  type                     DisputeCaseType
  status                   DisputeCaseStatus      @default(OPEN)
  clientId                 String
  providerId               String
  amountCents              Int
  mpPaymentId              String?
  contextNote              String?
  bookingId                String?
  consultancyContractId    String?
  presentialPackageId      String?
  presentialPackageCycleId String?
  trainingPlanId           String?
  noShowReportId           String?                @unique
  resolution               DisputeCaseResolution?
  resolvedAmountCents      Int?
  resolutionNote           String?
  resolvedByAdminId        String?
  resolvedAt               DateTime?
  // Raio-X de pagamentos, Rodada 3, Lote 1: trava atômica auto-expirável
  // (mesmo idioma de ConsultancyContract.renewalDeliveryLockedAt) contra
  // dois admins resolvendo o mesmo caso ao mesmo tempo — evita reembolso
  // ou dívida duplicados.
  resolvingLockedAt        DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  client                 User                    @relation("DisputeCaseClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider               ProviderProfile         @relation("DisputeCaseProvider", fields: [providerId], references: [id], onDelete: Cascade)
  booking                Booking?                @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  consultancyContract    ConsultancyContract?    @relation(fields: [consultancyContractId], references: [id], onDelete: SetNull)
  presentialPackage      PresentialPackage?      @relation(fields: [presentialPackageId], references: [id], onDelete: SetNull)
  presentialPackageCycle PresentialPackageCycle? @relation(fields: [presentialPackageCycleId], references: [id], onDelete: SetNull)
  trainingPlan           TrainingPlan?           @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  noShowReport           NoShowReport?           @relation(fields: [noShowReportId], references: [id], onDelete: SetNull)
  resolvedByAdmin        User?                   @relation("DisputeCaseResolvedBy", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  debtRecords            DebtRecord[]

  @@index([status, createdAt])
  @@index([clientId])
  @@index([providerId])
}

enum DebtorType {
  PROVIDER
  CLIENT
}

enum DebtRecordStatus {
  PENDING
  NOTIFIED
  PAID
  WRITTEN_OFF
}

// Registro interno de "quem deve o quê, pra quem, por qual motivo" — sempre
// ligado ao DisputeCase que originou a divida (Frente 4 do roteiro de
// seguranca de pagamentos). Divida do personal nasce automatica sempre que
// uma disputa e resolvida como reembolso (o pagamento reembolsado ja estava
// capturado e repassado, entao o personal ja recebeu aquele valor). Divida
// do aluno nasce por acao manual do admin ao negar uma disputa, pro caso raro
// em que o aluno ja tinha recebido um reembolso indevido antes.
model DebtRecord {
  id            String           @id @default(uuid())
  disputeCaseId String
  debtorType    DebtorType
  clientId      String?
  providerId    String?
  amountCents   Int
  reason        String
  status        DebtRecordStatus @default(PENDING)
  mpPaymentId   String?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  disputeCase DisputeCase      @relation(fields: [disputeCaseId], references: [id], onDelete: Cascade)
  client      User?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  provider    ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([disputeCaseId])
}

model Review {
  id        String @id @default(uuid())
  bookingId String @unique
  userId    String

  providerId          String
  rating              Int
  comment             String?
  providerResponse    String?         @db.VarChar(500)
  providerRespondedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  booking             Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
