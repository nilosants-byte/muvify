model ClientAnamnesis {
  id          String          @id @default(uuid())
  clientId    String          @unique
  status      AnamnesisStatus @default(DRAFT)
  // Épico de Frentes, Frente 11, Lote 3: dado de saúde (doenças, cirurgias,
  // medicação) trafegava em texto plano no banco. Guarda o JSON cifrado
  // (encryptJson/decryptJson de src/shared/utils/encryption.ts) como
  // string, nunca o objeto em claro - toda leitura/escrita PRECISA passar
  // por esses helpers.
  answers     String?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  client      User            @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([clientId, updatedAt])
}

// Épico de Frentes, Frente 11, Lote 3: acesso de profissional à anamnese
// (dado de saúde) do aluno não deixava nenhuma trilha de quem consultou o
// quê e quando. Sem relação FK de propósito (mesmo padrão de
// PaymentAuditLog) - é só uma trilha de auditoria, nunca atualizada.
model HealthDataAccessLog {
  id         String   @id @default(uuid())
  providerId String
  clientId   String
  action     String
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([providerId, createdAt])
}

model ProviderStudentAssessment {
  id             String          @id @default(uuid())
  providerId     String
  clientId       String
  // Épico de Frentes, Frente 11, Lote 3: composição corporal é dado de
  // saúde e trafegava em texto plano. Todos os campos abaixo são cifrados
  // (encryptSensitiveText/decryptSensitiveText) por quem lê/escreve -
  // nunca gravar/ler direto sem passar pelos helpers.
  weight         String?
  height         String?
  imc            String?
  bodyFatPercent String?
  muscleMass     String?
  circumferences String?
  waist          String?
  hip            String?
  chest          String?
  arm            String?
  thigh          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  client         User            @relation("AssessmentClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([providerId, clientId])
  @@index([clientId, updatedAt])
  @@index([providerId, updatedAt])
}

model FinancialStudent {
