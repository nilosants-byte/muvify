model BookingMessage {
  id        String    @id @default(uuid())
  bookingId String
  senderId  String?
  isSystem  Boolean   @default(false)
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  hiddenByAdminAt DateTime?
  hiddenByAdminId String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
  reports BookingMessageReport[]
  hiddenByAdmin User? @relation("BookingMessageHiddenByAdmin", fields: [hiddenByAdminId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([senderId, createdAt])
}

// Épico de Frentes, Frente 9, Lote 10: denúncia de mensagem no chat de
// agendamento - espelha FeedPostReport (Frente 8, Lote 2).
model BookingMessageReport {
  id         String   @id @default(uuid())
  messageId  String
  reporterId String
  reason     String?
  status       ContentReportStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  createdAt  DateTime @default(now())
  message    BookingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("BookingMessageReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterId])
  @@index([messageId])
  @@index([status, createdAt])
}

// Épico de Frentes, Frente 9, Lote 7: chat de consultoria - espelha
// BookingMessage 1:1, generalizando a infraestrutura de chat já existente
// pra ConsultancyContract em vez de reaproveitar (retrofit) BookingMessage,
// que é semanticamente amarrado a Booking.
model ConsultancyMessage {
  id         String    @id @default(uuid())
  contractId String
  senderId   String?
  isSystem   Boolean   @default(false)
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  hiddenByAdminAt DateTime?
  hiddenByAdminId String?

  contract ConsultancyContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sender   User?                @relation(fields: [senderId], references: [id], onDelete: SetNull)
  reports  ConsultancyMessageReport[]
  hiddenByAdmin User? @relation("ConsultancyMessageHiddenByAdmin", fields: [hiddenByAdminId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([senderId, createdAt])
}

// Épico de Frentes, Frente 9, Lote 10: denúncia de mensagem no chat de
// consultoria - espelha BookingMessageReport/FeedPostReport.
model ConsultancyMessageReport {
  id         String   @id @default(uuid())
  messageId  String
  reporterId String
  reason     String?
  status       ContentReportStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  createdAt  DateTime @default(now())
  message    ConsultancyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User               @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("ConsultancyMessageReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterId])
  @@index([messageId])
  @@index([status, createdAt])
}

