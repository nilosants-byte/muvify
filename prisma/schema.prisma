model ConsultancyRequest {
  id                   String                   @id @default(uuid())
  providerId           String
  clientId             String
  trainingNeedText     String?
  limitationText       String?
  extraInfoText        String?
  providerResponseText String?
  status               ConsultancyRequestStatus @default(OPEN)
  quotedOfferId        String?
  responseDeadlineAt   DateTime
  // Raio-X de pagamentos, Rodada 4, Lote 10: só existia o aviso de expiração
  // (depois que já venceu) — nenhum lembrete antes disso, ao contrário do
  // padrão já usado pra confirmação de agendamento avulso (Rodada 4, Lote 4).
  responseReminderSentAt DateTime?
  respondedAt          DateTime?
  clientDecisionAt     DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  provider             ProviderProfile          @relation("ProviderConsultancyRequests", fields: [providerId], references: [id], onDelete: Cascade)
  client               User                     @relation("ClientConsultancyRequests", fields: [clientId], references: [id], onDelete: Cascade)
  quotedOffer          ProviderServiceOffer?    @relation("QuotedConsultancyOffer", fields: [quotedOfferId], references: [id], onDelete: SetNull)
  contract             ConsultancyContract?

  @@index([providerId, status, createdAt])
  @@index([clientId, status, createdAt])
}

model ConsultancyContract {
  id                      String                    @id @default(uuid())
  requestId               String                    @unique
  providerId              String
  clientId                String
  offerId                 String
  status                  ConsultancyContractStatus @default(PENDING_PAYMENT)
  paymentMethod           ConsultancyPaymentMethod?
  paymentInstallments     Int                       @default(1)
  paymentStatus           ConsultancyPaymentStatus  @default(PENDING)
  mpPaymentId             String?                   @unique
  mpRefundId              String?
  paymentAmountCents      Int
  providerAmountCents     Int
  platformAmountCents     Int
  // Épico de Frentes, Frente 6 (Ofertas do profissional), Lote 2: snapshot
  // congelado no momento da compra — sem isso, editar billingCycle/kind/
  // fichaValidityDays da oferta depois da venda mudava retroativamente a
  // vigência/categorização de contratos já ativos (mesma proteção que
  // PresentialPackage já tinha pros campos equivalentes, mas nunca foi
  // replicada aqui).
  billingCycle            OfferBillingCycle
  kind                    ServiceOfferKind
  fichaValidityDays       Int?
  paymentCapturedAt       DateTime?
  paymentCanceledAt       DateTime?
  deliveryDeadlineAt      DateTime
  immediateExecutionAcknowledgedAt DateTime
  deliveredAt             DateTime?
  refundedAt              DateTime?
  refundReason            String?
  expiry24hSentAt         DateTime?
  expiry6hSentAt          DateTime?
  expiryNoticeSentAt      DateTime?
  // Raio-X de pagamentos, Lote 4: trava leve contra duas entregas de
  // renovação de ficha quase simultâneas pro mesmo contrato (evita cobrar
  // e criar ficha duplicada) - via update condicional atômico, não trava
  // consultiva do Postgres (advisory lock não é seguro com o pool de
  // conexões do Prisma: quem pede e quem libera podem cair em conexões
  // diferentes). Expira sozinha em 30s caso o processo caia no meio.
  renewalDeliveryLockedAt DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  request                 ConsultancyRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider                ProviderProfile           @relation("ProviderConsultancyContracts", fields: [providerId], references: [id], onDelete: Cascade)
  client                  User                      @relation("ClientConsultancyContracts", fields: [clientId], references: [id], onDelete: Cascade)
  offer                   ProviderServiceOffer      @relation(fields: [offerId], references: [id], onDelete: Restrict)
  trainingPlans           TrainingPlan[]
  trainingPlanCompletions TrainingPlanCompletion[]
  presentialPackage       PresentialPackage?
  disputeCases            DisputeCase[]
  messages                ConsultancyMessage[]

  @@index([providerId, status, deliveryDeadlineAt])
  @@index([clientId, status, createdAt])
  @@index([clientId, paymentStatus, status])
}

