model TrainingPlanCompletion {
  id             String               @id @default(uuid())
  clientId       String
  providerId     String
  trainingPlanId String
  contractId     String?
  notes          String?
  completedAt    DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
