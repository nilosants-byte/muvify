model ProviderServiceOffer {
  id                         String                 @id @default(uuid())
  providerId                 String
  kind                       ServiceOfferKind
  title                      String
  billingCycle               OfferBillingCycle
  daysPerWeek                Int?
  comboPresentialDaysPerWeek Int?
  comboOnlineDaysPerWeek     Int?
  priceCents                 Int
  basePriceUpdatedAt         DateTime               @default(now())
  isPromotion                Boolean                @default(false)
  promotionPriceCents        Int?
  promotionEndsAt            DateTime?
  promotionLabel             String?
  acceptsPix                 Boolean                @default(true)
  acceptsDebitCard           Boolean                @default(true)
  acceptsCreditCard          Boolean                @default(true)
  isActive                   Boolean                @default(true)
  // Pacote presencial (PRESENTIAL/COMBO) — vendido por assinatura, nao pagamento unico.
  presentialPackageMode      PresentialPackageMode?
  presentialHasFixedTerm     Boolean                @default(false)
  presentialTotalCycles      Int?
  presentialSessionsPerCycle Int?
  // Combo: quanto de priceCents corresponde a cada lado, pra reembolso parcial sem ambiguidade.
  comboPresentialShareCents  Int?
  comboConsultancyShareCents Int?
  // Consultoria (ONLINE_CONSULTANCY/SPECIALIZED/metade online do COMBO): por
  // quantos dias cada ficha entregue vale, por padrao (o profissional pode
  // ajustar por entrega individualmente). Null preserva o comportamento
  // antigo (ficha herda a vigencia inteira do contrato).
  fichaValidityDays          Int?
  // Presencial/combo: local de atendimento especifico desta oferta (local
  // fixo, a domicilio, ou ambos) - null herda o serviceMode geral do perfil
  // do profissional. Só pode ser um subconjunto do que o perfil permite
  // (nao da pra oferecer domicilio numa oferta se o profissional nunca
  // habilitou atendimento a domicilio no perfil).
  offerServiceMode           ProviderServiceMode?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  provider                   ProviderProfile        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  quotedRequests             ConsultancyRequest[]   @relation("QuotedConsultancyOffer")
  contracts                  ConsultancyContract[]
  presentialPackages         PresentialPackage[]
  bookings                   Booking[]

  @@index([providerId, isActive])
  @@index([isPromotion, isActive])
}

enum PresentialPackageMode {
  FIXED_RECURRING
  FLEXIBLE_CREDITS
}

enum PresentialPackageStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// Pacote presencial cobrado em ciclos por chamadas normais de pagamento (nao
// pelo produto "Assinaturas" da MP - aquele nao suporta split nem Pix no
// corpo da requisicao, confirmado pelos tipos da propria SDK). Cada ciclo e
// uma cobranca nova gerada pelo cron (cartao salvo) ou manual (Pix), usando
// o mesmo mecanismo de split ja comprovado em booking/consultoria. Cancelar
// e so parar de gerar cobrancas futuras - nunca existe autorizacao "em
// aberto" na MP pra revogar. Sessoes viram Booking de verdade (packageId),
// entao Agenda/Financeiro/Gestao de Alunos ja enxergam tudo sem
// sincronizacao nova.
model PresentialPackage {
  id                    String                    @id @default(uuid())
  providerId            String
  clientId              String
  offerId               String
  categoryId            String
  consultancyContractId String?                   @unique
  mode                  PresentialPackageMode
  status                PresentialPackageStatus   @default(PENDING_PAYMENT)
  paymentMethod         ConsultancyPaymentMethod?
  cycleAmountCents      Int
  billingCycle          OfferBillingCycle
  sessionsPerCycle      Int
  weeklySchedule        Json?
  hasFixedTerm          Boolean                   @default(false)
  totalCycles           Int?
  validFrom             DateTime?
  validUntil            DateTime?
  expiryReminderSentAt  DateTime?
  cancelledAt           DateTime?
  // Local de atendimento das sessoes geradas pelo pacote - decidido uma vez
  // na compra (igual ao weeklySchedule) e aplicado a cada sessao gerada.
  sessionLocation       String?
  clientLatitude        Float?
  clientLongitude       Float?

  // Controle de cobranca recorrente
  nextCycleIndex            Int       @default(1)
  nextBillingAt             DateTime?
  consecutiveFailedCycles   Int       @default(0)
  billingCardId             String?
  // Épico de Frentes, Frente 6, Lote 10: comentário antigo citava
  // shared/utils/offer-installments.ts, um arquivo que nunca chegou a
  // existir - parcelamento real em cartão nunca foi implementado, sempre
  // 1x em todas as cobranças (purchasePackage, chargeCycle).
  paymentInstallments       Int       @default(1)
  creditsRemainingThisCycle Int       @default(0)
  lastBillingFailureReason  String?
  // Raio-X de pagamentos, Rodada 4, Lote 11: mesmo padrão do lembrete de
  // vencimento de créditos (sendFlexibleSessionPackExpiryReminders) — aqui
  // pra avisar antes da próxima cobrança automática de ciclo recorrente,
  // que hoje só acontecia sem aviso nenhum.
  billingReminderSentAt     DateTime?

  // Cobranca do ciclo atual ainda nao confirmada (cartao em processamento ou Pix aguardando pagamento manual)
  pendingChargeMpPaymentId      String?   @unique
  pendingChargePixQrCodeUrl     String?
  pendingChargePixCopyPasteCode String?
  pendingChargePixExpiresAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider            ProviderProfile          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  client              User                     @relation("ClientPresentialPackages", fields: [clientId], references: [id], onDelete: Cascade)
  offer               ProviderServiceOffer     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  category            ServiceCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  consultancyContract ConsultancyContract?     @relation(fields: [consultancyContractId], references: [id], onDelete: SetNull)
  bookings            Booking[]
  cycles              PresentialPackageCycle[]
  disputeCases        DisputeCase[]

  @@index([providerId, status])
  @@index([clientId, status])
  @@index([status, nextBillingAt])
}

// Um registro por periodo do pacote. Pra pacotes pagos em Pix (ou no formato
// de creditos flexiveis, que ainda usa cobranca por ciclo — ver memoria
// "pacote-creditos-flexiveis-pendente"), os campos de pagamento abaixo
// continuam preenchidos: e a fonte de receita real desse caso (Financeiro
// soma por aqui). Pra pacotes de horario fixo pagos em cartao, cada sessao
// virou um Booking/Payment de verdade (mesmo motor da sessao avulsa) — esse
// registro fica so como marcador do periodo (pra saber pra qual janela as
// sessoes ja foram geradas), sem nenhum valor de pagamento associado.
model PresentialPackageCycle {
  id                  String    @id @default(uuid())
  packageId           String
  cycleIndex          Int
  amountCents         Int?
  providerAmountCents Int?
  platformAmountCents Int?
  sessionsGranted     Int
  mpPaymentId         String?
  capturedAt          DateTime?
  periodStart         DateTime
  periodEnd           DateTime
  // Épico de Frentes, Frente 7, Lote 2: preenchidos quando uma disputa
  // vinculada a este ciclo (presentialPackageCycleId) é resolvida como
  // REFUNDED - sem isso, a receita do ciclo continuava contada pra sempre
  // nos relatórios financeiros mesmo depois do reembolso.
  refundedAt          DateTime?
  refundedAmountCents Int?

  package      PresentialPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  disputeCases DisputeCase[]

  @@unique([packageId, cycleIndex])
  @@index([packageId])
}

model TrainingPlan {
  id          String                   @id @default(uuid())
  providerId  String
  contractId  String?
  title       String
  description String?
  isPrebuilt  Boolean                  @default(true)
  isActive    Boolean                  @default(true)
  validUntil  DateTime?
  // Frente B (liberdade de ofertas): lembretes de renovacao de ficha
  // enviados ao profissional - evita reenviar o mesmo aviso a cada rodada
  // do job periodico.
  expiryReminderSentAt DateTime?
  expiredNoticeSentAt  DateTime?
  // Raio-X de pagamentos, Lote 4: quando a ficha vence e ninguem age (so pra
  // ofertas com renovacao esperada - fichaValidityDays configurado), controla
  // o throttle dos avisos escalonados (1x por dia) ate o encerramento
  // automatico apos 7 dias.
  lastEscalationSentAt DateTime?
  // Raio-X de pagamentos, Lote 4: id do pagamento no Mercado Pago que cobrou
  // ESSA renovacao especifica (null na 1a ficha, cuja cobranca ja fica em
  // ConsultancyContract.mpPaymentId) - permite contestar/reembolsar a
  // renovacao certa, nao sempre a cobranca original do contrato.
  renewalMpPaymentId String?
  // Épico de Frentes, Frente 7, Lote 2: preenchido quando uma disputa de
  // contestação de entrega (trainingPlanId) é resolvida como REFUNDED -
  // sem isso, a receita da renovação continuava contada pra sempre nos
  // relatórios financeiros mesmo depois do reembolso.
  refundedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  provider    ProviderProfile          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  contract    ConsultancyContract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  exercises   TrainingPlanExercise[]
  completions TrainingPlanCompletion[]
  disputeCases DisputeCase[]

  @@index([providerId, isPrebuilt, isActive])
  @@index([contractId])
}

