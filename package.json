{
  "name": "personal-services-marketplace-api",
  "version": "1.1.0",
  "description": "Backend modular para marketplace de servicos pessoais",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "prisma:generate": "node scripts/prisma-generate-safe.cjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "lint": "npm run prisma:generate && tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "seed:exercises": "tsx scripts/seed-exercises.ts",
    "seed:all": "npm run seed && npm run seed:exercises",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:backup:upload": "tsx scripts/db-backup-upload.ts",
    "db:backup:verify": "tsx scripts/db-backup-verify.ts",
    "db:backup:schedule": "tsx scripts/db-backup-schedule.ts",
    "data-retention:dry-run": "tsx scripts/data-retention-run.ts",
    "data-retention:apply": "tsx scripts/data-retention-run.ts --apply",
    "backfill:completion-evidence:dry-run": "tsx scripts/backfill-completion-evidence-r2.ts",
    "backfill:completion-evidence:apply": "tsx scripts/backfill-completion-evidence-r2.ts --apply",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "test:prepare": "node -e \"const cp=require('child_process'); require('dotenv').config(); const fallback='postgresql://postgres:postgres@127.0.0.1:5432/personal_app_test'; const raw=process.env.TEST_DATABASE_URL||fallback; const testUrl=raw.replace('@localhost:','@127.0.0.1:'); const env={...process.env, DATABASE_URL:testUrl, DIRECT_URL:testUrl}; cp.execSync('npx prisma migrate deploy',{stdio:'inherit',env});\"",
    "test": "npm run test:prepare && vitest run",
    "test:docker": "tsx scripts/test-docker.ts",
    "smoke:docker": "tsx scripts/smoke-docker.ts",
    "load:docker": "tsx scripts/load-docker.ts",
    "release:preflight": "node scripts/release-preflight.cjs",
    "release:preflight:strict": "node scripts/release-preflight.cjs --strict",
    "release:gate": "npm run lint && npm run test && npm run release:preflight:strict",
    "release:gate:full": "npm run qa:full && npm run release:preflight:strict",
    "e2e:mobile:all": "npm --prefix mobile-app run e2e:mobile:all",
    "e2e:mobile:smoke": "npm --prefix mobile-app run e2e:mobile:smoke",
    "e2e:mobile:batch:high": "npm --prefix mobile-app run e2e:mobile:batch:high",
    "e2e:mobile:batch:medium": "npm --prefix mobile-app run e2e:mobile:batch:medium",
    "e2e:mobile:batch:low": "npm --prefix mobile-app run e2e:mobile:batch:low",
    "e2e:mobile:batch:high:report": "npm --prefix mobile-app run e2e:mobile:batch:high:report",
    "e2e:mobile:batch:medium:report": "npm --prefix mobile-app run e2e:mobile:batch:medium:report",
    "e2e:mobile:batch:low:report": "npm --prefix mobile-app run e2e:mobile:batch:low:report",
    "e2e:mobile:report": "npm --prefix mobile-app run e2e:mobile:report",
    "qa:full": "npm run lint && npm run smoke:docker && npm run test:docker && npm --prefix mobile-app run typecheck && npm --prefix mobile-app run test -- --watch=false",
    "docs:openapi": "tsx scripts/export-openapi.ts",
    "push:test": "tsx scripts/push-send-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@prisma/client": "^6.5.0",
    "@sentry/node": "^10.48.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.4",
    "otplib": "^11.0.1",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.5.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.4"
  },
  "overrides": {
    "vite": {
      "yaml": "^2.4.2"
    }
  }
}
