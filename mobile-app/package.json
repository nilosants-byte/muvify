{
  "name": "mobile-app",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel -c",
    "start:ngrok": "node scripts/start-ngrok.mjs",
    "start:share": "node scripts/start-share.mjs",
    "start:lan": "node scripts/start-lan.mjs",
    "start:lan:detached": "node scripts/start-lan-detached.mjs",
    "start:dev-client": "expo start --dev-client --host lan",
    "start:dev-client:tunnel": "expo start --dev-client --host tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:build:dev:ios": "npx eas build --platform ios --profile development",
    "eas:build:dev:android": "npx eas build --platform android --profile development",
    "eas:device:create": "npx eas device:create",
    "eas:build:preview:android": "npx eas build --platform android --profile preview --non-interactive",
    "eas:build:preview:ios": "npx eas build --platform ios --profile preview --non-interactive",
    "eas:build:production:all": "npx eas build --platform all --profile production --non-interactive",
    "eas:submit:production:all": "npx eas submit --platform all --profile production --non-interactive",
    "capture:new-consultancy-screens": "node scripts/capture-new-consultancy-screens-local.mjs",
    "capture:new-consultancy-screens:managed": "node scripts/capture-new-consultancy-screens.mjs",
    "capture:official:dark-light": "node scripts/capture-official-34-dark-light.mjs",
    "capture:stitch:dark-light": "node scripts/export-stitch-screens.mjs",
    "capture:stitch:preview:dark-light": "node scripts/capture-stitch-preview-dark-light.mjs",
    "capture:stitch:fidelity:dark-light": "node scripts/build-fidelity-print-packs.mjs",
    "e2e:smoke": "maestro test e2e/maestro/smoke/",
    "e2e:auth": "maestro test e2e/maestro/auth/",
    "e2e:client": "maestro test e2e/maestro/client/",
    "e2e:professional": "maestro test e2e/maestro/professional/",
    "e2e:admin": "maestro test e2e/maestro/admin/",
    "e2e:all": "maestro test e2e/maestro/smoke/ e2e/maestro/auth/ e2e/maestro/client/ e2e/maestro/professional/ e2e/maestro/admin/",
    "e2e:report": "maestro test --format junit e2e/maestro/smoke/ e2e/maestro/auth/ e2e/maestro/client/ e2e/maestro/professional/ e2e/maestro/admin/ 2>&1 | tee e2e/maestro/reports/report.xml",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "validate:release": "npm run typecheck && npm run test:coverage && npm run doctor",
    "mock:api": "node ../scripts/mock-mobile-api.js",
    "start:e2e:lan": "node scripts/start-e2e-lan.mjs",
    "e2e:mobile:all": "node e2e/helpers/run-maestro.mjs all",
    "e2e:mobile:smoke": "node e2e/helpers/run-maestro.mjs smoke",
    "e2e:mobile:professional": "node e2e/helpers/run-maestro.mjs professional",
    "e2e:mobile:module": "node e2e/helpers/run-maestro.mjs",
    "e2e:mobile:batch:high": "node e2e/helpers/run-maestro.mjs batch high",
    "e2e:mobile:batch:medium": "node e2e/helpers/run-maestro.mjs batch medium",
    "e2e:mobile:batch:low": "node e2e/helpers/run-maestro.mjs batch low",
    "e2e:mobile:batch:high:report": "node e2e/helpers/run-maestro.mjs batch high --report",
    "e2e:mobile:batch:medium:report": "node e2e/helpers/run-maestro.mjs batch medium --report",
    "e2e:mobile:batch:low:report": "node e2e/helpers/run-maestro.mjs batch low --report",
    "e2e:mobile:report": "node e2e/helpers/run-maestro.mjs all --report"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.2.3",
