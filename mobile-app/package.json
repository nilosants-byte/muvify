{
  "name": "mobile-app",
  "version": "1.1.0",
  "main": "index.ts",
  "overrides": {
    "metro": "0.87.1",
    "metro-config": "0.87.1",
    "metro-transform-worker": "0.87.1"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel -c",
    "start:ngrok": "node scripts/start-ngrok.mjs",
    "start:share": "node scripts/start-share.mjs",
    "start:lan": "node scripts/start-lan.mjs",
    "start:lan:detached": "node scripts/start-lan-detached.mjs",
    "start:dev-client": "expo start --dev-client --host lan",
    "start:dev-client:tunnel": "expo start --dev-client --host tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:build:dev:ios": "npx eas build --platform ios --profile development",
    "eas:build:dev:android": "npx eas build --platform android --profile development",
    "eas:device:create": "npx eas device:create",
    "eas:build:preview:android": "npx eas build --platform android --profile preview --non-interactive",
    "eas:build:preview:ios": "npx eas build --platform ios --profile preview --non-interactive",
    "eas:build:production:all": "npx eas build --platform all --profile production --non-interactive",
    "eas:submit:production:all": "npx eas submit --platform all --profile production --non-interactive",
    "eas:update:preview": "npx eas update --branch preview --message",
    "eas:update:production": "npx eas update --branch production --message",
    "capture:new-consultancy-screens": "node scripts/capture-new-consultancy-screens-local.mjs",
    "capture:new-consultancy-screens:managed": "node scripts/capture-new-consultancy-screens.mjs",
    "capture:official:dark-light": "node scripts/capture-official-34-dark-light.mjs",
    "capture:stitch:dark-light": "node scripts/export-stitch-screens.mjs",
    "capture:stitch:preview:dark-light": "node scripts/capture-stitch-preview-dark-light.mjs",
    "capture:stitch:fidelity:dark-light": "node scripts/build-fidelity-print-packs.mjs",
    "e2e:smoke": "maestro test e2e/smoke/",
    "e2e:auth": "maestro test e2e/auth/",
    "e2e:client": "maestro test e2e/client/",
    "e2e:professional": "maestro test e2e/professional/",
    "e2e:admin": "maestro test e2e/admin/",
    "e2e:all": "maestro test e2e/smoke/ e2e/auth/ e2e/client/ e2e/professional/ e2e/admin/",
    "e2e:report": "maestro test --format junit e2e/smoke/ e2e/auth/ e2e/client/ e2e/professional/ e2e/admin/ 2>&1 | tee e2e/reports/report.xml",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "validate:release": "npm run typecheck && npm run test:coverage && npm run doctor",
    "mock:api": "node ../scripts/mock-mobile-api.js",
    "start:e2e:lan": "node scripts/start-e2e-lan.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.2.3",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/config-plugins": "~58.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.20",
    "expo-modules-core": "~58.0.28",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.19",
    "expo-video-thumbnails": "~58.0.2",
    "leaflet": "^1.9.4",
    "lottie-react-native": "~7.5.0",
    "posthog-react-native": "^4.46.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "playwright": "^1.58.2",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
