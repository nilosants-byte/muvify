{
  "expo": {
    "name": "muvify",
    "slug": "muvify",
    "scheme": "muvify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash/splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFCFA",
      "dark": {
        "image": "./assets/splash/splash-dark.png",
        "backgroundColor": "#080C09"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muvify.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.muvify.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#070B08",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/1f205c7e-3d1f-46c5-b0b1-9b603a290049",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Muvify acesse sua localização para configurar sua área de atendimento.",
          "locationAlwaysAndWhenInUsePermission": "Permita que o Muvify acesse sua localização em segundo plano para atualizar sua disponibilidade no mapa de alunos.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita acesso à câmera para capturar selfie de confirmação de presença nos agendamentos."
        }
      ],
      "expo-notifications",
      "expo-dev-client",
      "expo-updates",
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "1f205c7e-3d1f-46c5-b0b1-9b603a290049"
      }
    },
    "owner": "dancsan"
  }
}
